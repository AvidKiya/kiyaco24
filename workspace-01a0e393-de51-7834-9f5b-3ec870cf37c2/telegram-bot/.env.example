# ===== تنظیمات ربات تلگرام ژیوار =====
# این فایل رو کپی کن به .env و مقادیر رو پر کن

# توکن ربات از @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAF...

# آیدی عددی ادمین‌ها (با کاما جدا کن) — از @userinfobot بگیر
ADMIN_IDS=123456789,987654321

# آیدی کانال (مثل @ZhevarStyle یا -100...)
CHANNEL_ID=@ZhevarStyle

# آدرس API بک‌اند فروشگاه
API_BASE_URL=https://api.zhevar.shop/api

# ===== هوش مصنوعی =====
# کلید API سرویس هوش مصنوعی (OpenAI-compatible — می‌تونه سرویس ایرانی یا واسط باشه)
AI_API_KEY=sk-...
# آدرس سرویس (قابل تغییر به سرویس‌دهنده ایرانی)
AI_BASE_URL=https://api.openai.com/v1
# مدل مورد استفاده
AI_MODEL=gpt-4o-mini

# حالت اجرا: polling (ساده) یا webhook (توصیه شده برای پروداکشن)
BOT_MODE=polling
# برای webhook:
WEBHOOK_DOMAIN=https://bot.zhevar.shop
PORT=3000
