# The managed preview provides DATABASE_URL automatically.
DATABASE_URL=

# Required in production for the one-time owner setup at /admin.
# Generate a long random secret; never commit the real .env file.
ADMIN_SETUP_KEY=

# Set to the actual HTTPS origin of the deployed shop.
NEXT_PUBLIC_SITE_URL=https://kiyaco24.ir

# Optional: automatic order notifications to the owner's Telegram chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- فاز ۱۰: اعلان‌ها و مارکتینگ اتوماسیون ---
# پنل پیامک ایرانی: kavenegar (پیش‌فرض) یا smsir
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=

# سرویس ایمیل (هاست اشتراکی یا API ایمیل)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# اعلان مرورگر (Web Push) — با: node scripts/generate-vapid.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# محافظ endpoint کرون /api/cron/notify (اختیاری ولی برای پروداکشن توصیه‌شده)
CRON_SECRET=

# ---- فاز ۱۱: لایهٔ هوش مصنوعی (اختیاری — از پنل هم قابل تنظیم است) ----
# هر سرویس OpenAI-compatible: سرویس‌دهندهٔ ایرانی، واسط معتبر یا مدل متن‌باز روی سرور خودتان
# اولویت با مقادیر ذخیره‌شده در پنل است؛ این env ها فقط جایگزین (fallback) هستند.
# بدون هیچ کلیدی، «موتور آفلاین» قانون‌محور همهٔ قابلیت‌ها را پوشش می‌دهد.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- فاز ۱۴: درگاه پرداخت زرین‌پال (از پنل هم قابل تنظیم است؛ env فقط جایگزین) ---
# بدون مرچنت‌کد، «درگاه آزمایشی داخلی» فعال می‌ماند.
ZARINPAL_MERCHANT_ID=
